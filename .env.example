# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会进仓库
# cp .env.example .env

# 运行环境：dev / prod
# prod 下若 SECRET_KEY 仍是默认值或短于 32 字符，应用会拒绝启动
ENV=dev

APP_NAME=AI Chat Backend

# 数据库：默认 SQLite，生产建议 PostgreSQL
# postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./ai_chat.db
# 是否把 SQL 打到日志（开发排查用，生产必须 false）
SQL_ECHO=false

# 服务间调用凭证：请求头 X-API-Key 必须与之一致
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=dev-api-key-change-me

# JWT 签名密钥
# ⚠️ HS256 是对称算法：拿到它就能伪造任意用户的 token
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
