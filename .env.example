# ============================================================================
# 环境变量样例。用法：cp .env.example .env
# 每一项都写了"改它会发生什么"，请按需改值，不要改键名（键名 = Settings 字段名）。
# .env 已在 .gitignore 里，不会进仓库；生产环境请用容器环境变量/KMS 注入，
# 不要把这个文件当成生产配置模板直接 scp 上线。
# ============================================================================

# ---- 运行环境 ----
# dev / prod。改成 prod 会触发启动守卫：SECRET_KEY 仍是默认值或短于 32 字符、
# 或 DEBUG=true，应用会直接拒绝启动（宁可不跑，也不要带着能伪造 token 的配置上线）。
ENV=dev

# ---- 服务标识 ----
# 只影响 /docs 标题、OpenAPI 信息与启动日志，改它不改变任何行为。
APP_NAME=AI Chat Backend

# ---- 数据库 ----
# 改成别的库会立刻切换全部读写目标（不会自动建表，记得跑 alembic upgrade head）。
# 默认 SQLite 仅适合本地开发：单写锁、无并发写、无网络访问。
# PostgreSQL 示例：postgresql+psycopg://user:password@127.0.0.1:5432/ai_chat
DATABASE_URL=sqlite:///./ai_chat.db
# true 会把每条 SQL 打到日志（含参数值）。开发查 N+1 很有用；
# 生产必须 false —— 日志量爆炸，且参数里可能有用户内容。
SQL_ECHO=false

# ---- 内部接口凭证（/internal/*，请求头 X-API-Key）----
# 改它之后所有运维脚本/定时任务必须同步改，否则全部 401。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=dev-api-key-change-me

# ---- JWT ----
# ⚠️ 改它 = 让所有已签发的 token 立即失效（正确用法是"怀疑泄露时轮换"）。
# HS256 是对称算法：拿到这把密钥就能伪造任意用户的 token，等价于拿到全部账号。
# 生产必须由环境变量/KMS 注入，长度 ≥32 字符。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
# 改成别的算法（如 HS512）会让存量 token 全部校验失败。
# 不支持 none / RS256：校验时写死只认这一个值，防 alg 混淆攻击。
ALGORITHM=HS256
# token 有效期（分钟）。改大 = 被盗 token 的可用窗口变长；改小 = 用户更频繁重新登录。
# 没有 refresh token，所以调得太小（如 5）会明显影响体验。
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- 日志 ----
# DEBUG / INFO / WARNING / ERROR / CRITICAL（大小写不敏感，拼错会拒绝启动）。
# 改成 DEBUG 会输出每条 SQL 细节与调试日志，只适合本地排障。
LOG_LEVEL=INFO
# true = 单行 JSON（给 ELK / Loki / CloudWatch）；false = 人读的竖线分隔格式。
# 容器部署建议 true，本地看日志建议 false。
LOG_JSON=false
# 彩色输出。不设置（整行注释掉）= 自动判断（stdout 是 TTY 才上色）。
# 注意：写成 `LOG_COLOR=` 空值会解析失败，要么删掉整行，要么给 true/false。
# LOG_COLOR=false

# ---- 调试开关 ----
# true 时额外挂载 /api/v1/debug/*（能主动打日志、抛异常），且仍需 token。
# 生产/ENV=prod 时设为 true 会直接拒绝启动。
DEBUG=false

# ---- CORS ----
# 允许的前端来源，逗号分隔，不要加引号和空格。
# 改它 = 决定哪些站点能在浏览器里带着凭证调本服务；漏配的表现是
# 前端请求被浏览器拦下（Network 面板显示 CORS error，服务端日志里却一切正常）。
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ---- LLM 上游（OpenAI 兼容接口）----
# 换供应商只需改这里（DeepSeek / 通义 / 自建网关都吃 /chat/completions）。
LLM_BASE_URL=https://api.deepseek.com/v1
# 留空时 /chat 直接返回 502 LLM_UNAVAILABLE，不会把空凭证发给上游。
# 改它 = 切换计费账号；泄露后请立刻在供应商后台吊销。
LLM_API_KEY=
# 单次调用超时（秒）。调大会让线程池被慢请求占满；调小会误伤长回答。
LLM_TIMEOUT_SECONDS=30
# true = 使用回显式假模型，不发任何网络请求（scripts/smoke.sh 默认开启）。
# 生产必须 false：开着它服务永远不会真调模型，但接口一切正常，最难发现。
LLM_MOCK=false
